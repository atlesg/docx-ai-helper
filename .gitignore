# ==========================================
# Rust / Tauri Backend Dependencies & Builds
# ==========================================
# Contains heavy compiled binaries and build artifacts
**/src-tauri/target/

# Automatically generated mobile/schema assets you don't need to track
**/src-tauri/gen/
**/src-tauri/gen/schemas/

# ==========================================
# Node.js / Frontend Bundler (Vite, Next, etc.)
# ==========================================
# Production frontend build outputs (adjust to match your framework's folder, e.g., /dist, /out, /.next)
/dist/
/out/
/.next/
/build/

# Frontend dependencies
node_modules/
.npm/
.yarn/
.pnpm-debug.log*

# ==========================================
# Logs and Runtime Data
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Strictly ignore secrets to avoid leaking API keys or signing certificates
.env
.env.local
.env.*.local
*.pem
*.pfx
*.keystore

# ==========================================
# IDEs, Editors, and OS Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
